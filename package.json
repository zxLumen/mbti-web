{
  "name": "mbti-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm start",
    "build": "vite build web --emptyOutDir",
    "start": "node --env-file-if-exists=.env.local --env-file-if-exists=.env --experimental-strip-types server.js",
    "watch": "node --watch --env-file-if-exists=.env.local --env-file-if-exists=.env --experimental-strip-types server.js",
    "typecheck": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.1.1"
  }
}
