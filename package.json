{
  "name": "mbti-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c green,cyan \"npm run server:dev\" \"npm run web:dev\"",
    "server:dev": "nodemon --watch server.js --exec \"node server.js\"",
    "web:dev": "vite web --host",
    "build": "vite build web --emptyOutDir",
    "preview": "node server.js",
    "start": "node server.js",
    "typecheck": "tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.1.1"
  }
}
